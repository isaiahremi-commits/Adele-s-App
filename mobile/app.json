{
  "expo": {
    "name": "Manadele",
    "slug": "manadele",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.apptage.manadele",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NFCReaderUsageDescription": "Manadele uses NFC to let you clock in and out by tapping the tag at your outlet."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG",
          "NDEF"
        ],
        "com.apple.developer.associated-domains": []
      }
    },
    "android": {
      "package": "com.apptage.manadele",
      "versionCode": 1,
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3A1F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Manadele uses NFC to let you clock in and out by tapping the tag at your outlet."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F2E1"
        }
      ]
    ]
  }
}
